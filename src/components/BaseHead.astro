---
import { BASE, absoluteUrl } from '../utils/urls'

interface Props {
  title: string
  description: string
  /** Absolute-on-site path, e.g. /posts/hello-world/ */
  path: string
  site?: URL
  publishedTime?: Date
  modifiedTime?: Date
  author?: string
  tags?: string[]
  type?: 'website' | 'article'
}

const {
  title,
  description,
  path,
  site,
  publishedTime,
  modifiedTime,
  author = 'Poly Forest',
  tags = [],
  type = 'website',
} = Astro.props

const canonical = absoluteUrl(path, site ?? Astro.site)
const socialImage = absoluteUrl('/social-card.png', site ?? Astro.site)
const socialImageAlt = `Poly Forest blog — ${title}`

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : 'WebSite',
  headline: title,
  description,
  url: canonical,
  image: socialImage,
  publisher: {
    '@type': 'Organization',
    name: 'Poly Forest',
    url: 'https://www.polyforest.com/',
  },
}
if (type === 'article') {
  jsonLd.author = { '@type': 'Person', name: author }
  if (publishedTime) {
    jsonLd.datePublished = publishedTime.toISOString()
    jsonLd.dateModified = (modifiedTime ?? publishedTime).toISOString()
  }
  if (tags.length) jsonLd.keywords = tags.join(', ')
}
---

<!-- Global metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#191919" />

<link rel="icon" sizes="192x192" href={`${BASE}/polyForestIcon192.png`} />
<link rel="apple-touch-icon" sizes="192x192" href={`${BASE}/polyForestIcon192.png`} />
<link rel="apple-touch-icon-precomposed" sizes="192x192" href={`${BASE}/polyForestIcon192.png`} />
<link rel="sitemap" href={`${BASE}/sitemap-index.xml`} />
<link rel="alternate" type="application/rss+xml" title="Poly Forest Blog" href={absoluteUrl('/rss.xml', site ?? Astro.site)} />
<link rel="canonical" href={canonical} />

<!-- Primary meta -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={socialImageAlt} />
<meta property="og:site_name" content="Poly Forest Blog" />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
