---
import { withBase } from '../utils/urls'

const { current = '' } = Astro.props

const links = [
  { href: '/', label: 'Posts' },
  { href: '/about/', label: 'About' },
]
---

<header class="site-header">
  <nav aria-label="Main">
    <a class="brand" href={withBase('/')}>
      <img
        class="logo"
        src={withBase('/assets/polyforest-logo.svg')}
        alt="Poly Forest"
        width="110"
        height="28"
      />
    </a>
    <div class="nav-links">
      {links.map(({ href, label }) => (
        <a href={withBase(href)} aria-current={current === href ? 'page' : undefined}>{label}</a>
      ))}
      <a class="ext" href="https://www.polyforest.com/">polyforest.com</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: rgba(25, 25, 25, 0.85);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  nav {
    max-width: var(--wide-max-width);
    margin: 0 auto;
    padding: 0.8rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .brand .logo {
    display: block;
    height: 28px;
    width: auto;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.95rem;
  }
  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--accent);
  }
  .nav-links .ext {
    color: var(--text-faint);
  }
</style>
