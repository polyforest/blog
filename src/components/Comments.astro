---
interface Props {
  /** Absolute URL of the post, forwarded to giscus for backlinks. */
  url: string
}

const { url } = Astro.props

// giscus conversation config — ids read off giscus.app after the repo-admin
// setup (Discussions enabled, giscus App installed, "Comments" category).
// mapping "pathname" means page identity includes the /blog base, so renaming
// a post slug orphans its thread.
const GISCUS = {
  repo: 'polyforest/blog',
  repoId: 'R_kgDOUqPCgw',
  category: 'Comments',
  categoryId: 'DIC_kwDOUqPCg84DGWLf',
  mapping: 'pathname',
  strict: '1',
  reactionsEnabled: '1',
  emitMetadata: '0',
  inputPosition: 'bottom',
  theme: 'transparent_dark',
  lang: 'en',
} as const
---

<aside class="comments" aria-label="Comments">
  <p class="label">Comments</p>
  <div class="giscus-mount" data-config={JSON.stringify(GISCUS)} data-origin={url}></div>
</aside>

<style>
  .comments {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    max-width: var(--max-width);
    margin-left: auto;
    margin-right: auto;
  }
  .label {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>

<script>
  // Lazy-mount giscus: inject the client only when the section nears the
  // viewport, so post pages never pay the widget's weight up front. The
  // config is serialized onto the mount node at build time.
  const mount = document.querySelector<HTMLElement>('.comments .giscus-mount')
  if (mount) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        io.disconnect()
        const cfg = JSON.parse(mount.dataset.config ?? '{}') as Record<string, string>
        const script = document.createElement('script')
        script.src = 'https://giscus.app/client.js'
        script.crossOrigin = 'anonymous'
        script.async = true
        for (const [key, value] of Object.entries(cfg)) {
          script.setAttribute(`data-${key.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)}`, value)
        }
        script.setAttribute('data-origin', mount.dataset.origin ?? '')
        mount.replaceWith(script)
      },
      { rootMargin: '200px' },
    )
    io.observe(mount)
  }
</script>
