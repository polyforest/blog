---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostLayout from '../layouts/PostLayout.astro'
import { absoluteUrl } from '../utils/urls'

export async function getStaticPaths() {
  // Drafts get a page in `npm run dev` only, so they can be previewed at
  // /<slug>/; builds (and the index, tags and feeds) never include them.
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const url = absoluteUrl(`/${post.id}/`, Astro.site)
---

<BaseLayout
  title={`${post.data.title} — PolyForest Blog`}
  description={post.data.description}
  path={`/${post.id}/`}
  site={Astro.site}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  author={post.data.author}
  tags={post.data.tags}
>
  <PostLayout post={post} url={url}>
    <Content />
  </PostLayout>
</BaseLayout>
