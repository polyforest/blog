---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../utils/urls'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
---

<BaseLayout title={`${SITE_TITLE} · engineering notes`} description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>Poly Forest <span class="accent">Blog</span></h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  <section class="listing" aria-label="Posts">
    {posts.length === 0 && <p class="empty">Nothing published yet. The first post is in the works.</p>}
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3.5rem 0 2.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
  }
  .hero h1 {
    font-size: 3rem;
    margin: 0 0 0.4em;
  }
  .accent {
    color: var(--accent);
  }
  .hero p {
    color: var(--text-muted);
    margin: 0 auto;
    max-width: 34rem;
  }
  .listing {
    max-width: var(--max-width);
    margin: 0 auto;
    padding-bottom: 2rem;
  }
  .empty {
    text-align: center;
    color: var(--text-faint);
    padding: 3rem 0;
  }
</style>
