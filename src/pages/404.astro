---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../utils/urls'
---

<BaseLayout title="Page not found · Poly Forest Blog" description="This page doesn't exist.">
  {/* Legacy /blog/ links (pre-custom-domain) 301 to the custom domain with the
      path intact, land on this 404 page (GitHub Pages serves 404.html for any
      unknown path), and get rewritten here once, client-side. A no-op for
      genuine 404s. */}
  <script is:inline>
    if (location.pathname.startsWith('/blog/')) {
      location.replace(
        location.pathname.replace(/^\/blog/, '') + location.search + location.hash
      )
    }
  </script>
  <section class="notfound">
    <h1>Lost in the woods</h1>
    <p>There's no page at this URL. Either the link is old or it never worked.</p>
    <p class="notfound-home"><a href={withBase('/')}>Back to the campfire</a></p>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding: 5rem 0 3rem;
  }
  .notfound h1 {
    font-size: 3rem;
    margin-bottom: 0.6em;
  }
  .notfound p {
    max-width: 34rem;
    margin-left: auto;
    margin-right: auto;
    color: var(--text-muted);
  }
  .notfound-home {
    margin-top: 2.5rem;
    font-size: 1.1rem;
  }
</style>
