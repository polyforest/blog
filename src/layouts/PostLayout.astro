---
import type { CollectionEntry } from 'astro:content'
import { AUTHOR, formatDate, withBase } from '../utils/urls'
import ShareLinks from '../components/ShareLinks.astro'

interface Props {
  post: CollectionEntry<'blog'>
  url: string
}

const { post, url } = Astro.props
const { title, pubDate, updatedDate, author = AUTHOR, tags } = post.data
---

<article class="post">
  <header class="post-header">
    <p class="date">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <span class="updated"> · updated {formatDate(updatedDate)}</span>}
    </p>
    <h1>{title}</h1>
    <p class="byline">
      <img class="avatar" src={withBase('/authors/nicholas-bilyk.svg')} width="28" height="28" alt="" />
      <span>{author}</span>
      {tags.length > 0 && (
        <span class="tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </span>
      )}
    </p>
  </header>

  <div class="prose">
    <slot />
  </div>

  <ShareLinks url={url} title={title} />
</article>

<style>
  .post-header {
    padding: 3rem 0 0;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .date {
    margin: 0 0 0.5em;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .updated {
    text-transform: none;
    letter-spacing: 0;
  }
  h1 {
    margin: 0 0 0.5em;
    font-size: 2.6rem;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 2.5rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .avatar {
    border-radius: 50%;
    background: var(--bg-raised);
  }
  .tags {
    display: inline-flex;
    gap: 0.4rem;
    margin-left: 0.4rem;
  }
  .tag {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15em 0.7em;
  }
  .prose {
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .share {
    max-width: var(--max-width);
    margin-left: auto;
    margin-right: auto;
  }
</style>
