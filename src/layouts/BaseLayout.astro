---
import '@fontsource/scope-one'
import '../styles/global.css'
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
  /** Absolute-on-site path, e.g. /hello-world/ */
  path?: string
  site?: URL
  type?: 'website' | 'article'
  publishedTime?: Date
  modifiedTime?: Date
  author?: string
  tags?: string[]
}

const { title, description, path = '/', site, type, publishedTime, modifiedTime, author, tags } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      path={path}
      site={site}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: var(--wide-max-width);
    margin: 0 auto;
    padding: 0 1.25rem;
  }
</style>
